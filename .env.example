# Copy to .env (never commit .env). All values are optional unless noted.

# --- Core ---------------------------------------------------------------
# SECRET_KEY=            # default: random key generated into instance/secret_key.txt
# COOKIE_SECURE=1        # set to 1 when served over HTTPS
# FLASK_DEBUG=0          # 1 only for local development
# TRUSTED_PROXY_COUNT=0  # number of reverse proxies in front of the app (for rate limiting by client IP)
# REEXAM_INSTANCE_DIR=   # where account files are stored (default: ./instance)

# --- First-start administrator (only used when instance/admin_credentials.json does not exist)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=        # default "admin" - change it after first login if you leave this unset

# --- Password-reset e-mail (all three of SMTP_HOST, MAIL_FROM, APP_BASE_URL are needed to enable e-mail)
# APP_BASE_URL=https://scheduler.example.edu   # used to build the reset link; no trailing slash
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls | ssl | none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Re-Exam Scheduler <no-reply@example.edu>
# ADMIN_EMAIL=             # where the administrator's reset link is sent (the admin account has no email of its own)
# RESET_TOKEN_MINUTES=30   # 5-1440
